# SMART CCTV AI - Environment Configuration
# Copy this file to .env and configure your local settings.
# NEVER commit .env with real credentials into source control.

# Application Environment (development, testing, production)
APP_ENV=development

# Optional default camera credentials for RTSP authentication
# In production, use Windows Credential Manager or app UI secure storage.
DEFAULT_RTSP_USER=admin
DEFAULT_RTSP_PASS=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Test mode: set to True to automatically provision synthetic CCTV test feeds
ENABLE_SYNTHETIC_TEST_FEEDS=true
